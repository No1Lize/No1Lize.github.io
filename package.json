{
  "name": "lize-road-one",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:crawler": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "validate:tracking": "node scripts/validate-tracking-pages.mjs",
    "validate:taxonomy": "node --import tsx scripts/validate-tracking-taxonomy.ts",
    "validate:tracking-snapshot": "node scripts/validate-tracking-snapshot.mjs",
    "verify:tracking-pages": "node scripts/validate-tracking-pages.mjs --check-output",
    "build:pages": "npm run validate:tracking && npm run validate:taxonomy && npm run validate:tracking-snapshot && node scripts/build-pages.mjs && npm run verify:tracking-pages && node scripts/validate-static-links.mjs",
    "crawl": "python3 tools/crawl_articles.py",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pdfjs-dist": "6.1.200",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "丽泽路1号"
}
